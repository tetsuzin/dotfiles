root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.json]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Windows PowerShell 5.1 は BOM が無いと UTF-8 として読まない
[*.ps1]
charset = utf-8-bom

# cmd は OEM コードページで読むため ASCII のみ。改行は CRLF
[*.cmd]
end_of_line = crlf

[dotfiles/.config/git/config]
indent_style = tab
tab_width = 4
