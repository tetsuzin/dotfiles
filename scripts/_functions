#!/usr/bin/env bash

RED=$'\033[0;31m'
YELLOW=$'\033[1;33m'
GREEN=$'\033[0;32m'
CYAN=$'\033[0;36m'
NC=$'\033[0m'

function _log() {
  local label=$1
  local color=$2
  local fd=$3
  shift 3

  local prefix=""
  local suffix=""

  if [[ -t "${fd}" && "${NO_COLOR+x}" != "x" && "${TERM:-}" != "dumb" ]]; then
    prefix="${color}"
    suffix="${NC}"
  fi

  printf '%s[%s]%s %s\n' \
    "${prefix}" "${label}" "${suffix}" "$*" >&"${fd}"
}

function log_step() {
  _log "STEP " "${GREEN}" 1 "$@"
}

function log_debug() {
  [[ "${LOG_DEBUG:-false}" == "true" ]] || return 0
  _log "DEBUG" "${CYAN}" 1 "$@"
}

function log_info() {
  _log "INFO " "${GREEN}" 1 "$@"
}

function log_warning() {
  _log "WARN " "${YELLOW}" 2 "$@"
}

function log_error() {
  _log "ERROR" "${RED}" 2 "$@"
}

function fail() {
  log_error "$@"
  exit 1
}

function check_nix() {
  local nix_version_output nix_version version_major version_minor
  local version_pattern='^nix[[:space:]]+\([^)]*\)[[:space:]]+([0-9]+)\.([0-9]+)(\.|$)'

  command -v nix &>/dev/null ||
    fail "Nix が見つかりません。先に ./setup.sh prepare を実行してください"

  nix_version_output="$(nix --version)"
  nix_version="${nix_version_output%%$'\n'*}"
  [[ "${nix_version_output}" != *Lix* ]] ||
    fail "子 flake 入力を利用するため、Lix から Nix 2.26 以上へ移行してください: ${nix_version}"
  [[ "${nix_version}" =~ ${version_pattern} ]] ||
    fail "Nix のバージョンを判定できません: ${nix_version}"

  version_major=$((10#${BASH_REMATCH[1]}))
  version_minor=$((10#${BASH_REMATCH[2]}))
  (( version_major > 2 || (version_major == 2 && version_minor >= 26) )) ||
    fail "子 flake 入力には Nix 2.26 以上が必要です: ${nix_version}"
  log_debug "NIX: ${nix_version}"
}

function install_nix() {
  if command -v nix &>/dev/null; then
    check_nix
    log_info "Nix はインストール済みです: $(nix --version | head -n 1)"
    return
  fi

  log_step "Nix のインストール"
  curl --proto '=https' --tlsv1.2 -sSf -L https://nixos.org/nix/install |
    sh -s -- --daemon --yes --no-channel-add

  if [[ -e /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]]; then
    # shellcheck disable=SC1091
    source /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
  fi

  check_nix
  log_info "Nix をインストールしました: $(nix --version | head -n 1)"
}
